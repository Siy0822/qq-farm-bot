# syntax=docker/dockerfile:1.7
#
# 将本机已验证可用的 6099 NapCat 运行目录原样封装进镜像。
# 不再从 mlikiowa/napcat-docker:latest 抽取新版 QQ/NapCat，避免容器运行时
# 与宿主机成功链路发生 QQ 3.2.29 -> 3.2.30、NapCat bundle、原生模块差异。
#
# build context `host_napcat` 由 compose additional_contexts 指向
# /opt/napcat-shell.bak-20260709093049（/opt/napcat-shell 的真实目录）。

FROM node:20-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    NAPCAT_WORKDIR=/opt/napcat-docker \
    NAPCAT_LAUNCH_MODE=process \
    NAPCAT_LAUNCHER=/opt/napcat-shell/start-napcat-xvfb.sh \
    NAPCAT_BRIDGE_SOCKET=/run/qqfarm-napcat-bridge/bridge.sock \
    NAPCAT_BASE_URL=http://127.0.0.1:3001 \
    NAPCAT_WEBUI_BASE_URL=http://127.0.0.1:6099 \
    NAPCAT_TIMEOUT_MS=8000

# 与宿主机 start-napcat-xvfb.sh 所需环境对齐。这里不做“瘦身裁剪”：
# 目标是先把宿主机已跑通的二进制/原生库/资源完整复刻进容器。
RUN set -eux; \
    sed -i 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g; s|http://deb.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      xvfb xauth \
      libnss3 libnspr4 libgbm1 libasound2 \
      libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
      libcups2 libdbus-1-3 libdrm2 libgtk-3-0 \
      libnotify4 libsecret-1-0 libxcomposite1 libxdamage1 \
      libxfixes3 libxkbcommon0 libxrandr2 libxss1 libxtst6 \
      libx11-xcb1 libgnutls30 fonts-wqy-zenhei tini procps tzdata; \
    ln -sf /usr/share/zoneinfo/$TZ /etc/localtime; \
    echo "$TZ" > /etc/timezone; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 关键：完整复制宿主机 6099 那套，而不是重新下载 latest。
COPY --from=host_napcat . /opt/napcat-shell

WORKDIR /app
COPY napcat-bridge /app/napcat-bridge
COPY core/src/services/napcat-openauth.js /app/core/src/services/napcat-openauth.js

# bridge 唯一外部依赖。
RUN set -eux; \
    npm install --no-save --no-audit --no-fund node-fetch@2; \
    chmod +x /opt/napcat-shell/start-napcat-xvfb.sh; \
    mkdir -p /opt/napcat-docker /run/qqfarm-napcat-bridge; \
    npm cache clean --force

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get({socketPath:'/run/qqfarm-napcat-bridge/bridge.sock',path:'/health',timeout:4000},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["tini", "-s", "--"]
CMD ["node", "/app/napcat-bridge/server.js"]
